---
/*
 * Shows text with any word wrapped in underscores as an accent word, in a
 * thin, high-contrast serif italic. In Markdown, write `About _me_` to get
 * "About" plus an italic "me".
 */
interface Props {
  text: string;
}

const parts = Astro.props.text.split(/(_[^_]+_)/g).filter(Boolean);
---

{
  parts.map((part) =>
    part.length > 2 && part.startsWith('_') && part.endsWith('_') ? (
      <span class="accent-word">{part.slice(1, -1)}</span>
    ) : (
      part
    ),
  )
}
