---
import { url } from '../lib/content';

interface Props {
  name: string;
}

const { name } = Astro.props;

// The links in the top navigation bar, in order.
const links = [
  { label: 'Work samples', href: '/work/' },
  { label: 'About', href: '/about/' },
  { label: 'Résumé', href: '/resume/' },
  { label: 'Contact', href: '/contact/' },
];

const current = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => current.startsWith(url(href));
---

<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href={url('/')}>{name}</a>

    <nav class="site-nav" aria-label="Main">
      <button
        class="icon-button menu-button"
        type="button"
        aria-expanded="false"
        aria-controls="nav-links"
      >
        <span class="visually-hidden">Menu</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-open">
          <path d="M4 8h16M4 16h16"></path>
        </svg>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-close">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>

      <ul id="nav-links" class="nav-links">
        {
          links.map((link) => (
            <li>
              <a href={url(link.href)} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="icon-button theme-toggle" type="button" aria-label="Switch to dark mode">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-moon">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
      </svg>
      <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-sun">
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
        ></path>
      </svg>
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  const isDark = () => root.dataset.theme === 'dark';
  const sync = () => {
    toggle?.setAttribute('aria-label', isDark() ? 'Switch to light mode' : 'Switch to dark mode');
    themeColor?.setAttribute('content', isDark() ? '#1f1c19' : '#faf7f2');
  };

  sync();
  toggle?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    if (next === 'dark') root.dataset.theme = 'dark';
    else delete root.dataset.theme;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    sync();
  });

  const menuButton = document.querySelector<HTMLButtonElement>('.menu-button');
  menuButton?.addEventListener('click', () => {
    const open = menuButton.getAttribute('aria-expanded') !== 'true';
    menuButton.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
      menuButton.setAttribute('aria-expanded', 'false');
      menuButton.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: var(--header-height);
  }

  .wordmark {
    margin-right: auto;
    color: var(--heading);
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 500;
    font-variation-settings: 'SOFT' 100, 'WONK' 0;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark:hover {
    color: var(--heading);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links a {
    position: relative;
    display: block;
    padding: 0.5rem 0.85rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 0.2rem;
    height: 1.5px;
    border-radius: 2px;
    background: var(--blush);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }

  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--heading);
  }

  .nav-links a:hover::after,
  .nav-links a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .icon-button {
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    color: var(--text-muted);
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .icon-button:hover {
    color: var(--heading);
    background: var(--section);
  }

  .icon-button svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-sun,
  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }

  .menu-button {
    display: none;
  }

  @media (max-width: 760px) {
    .site-nav {
      order: 2;
    }

    .menu-button {
      display: inline-grid;
    }

    .menu-button .icon-close,
    .menu-button[aria-expanded='true'] .icon-open {
      display: none;
    }

    .menu-button[aria-expanded='true'] .icon-close {
      display: block;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem var(--gutter) 1.25rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow);
    }

    .menu-button[aria-expanded='true'] + .nav-links {
      display: flex;
    }

    .nav-links a {
      padding: 0.9rem 0.25rem;
      border-bottom: 1px solid var(--border);
      font-size: 1.0625rem;
    }

    .nav-links li:last-child a {
      border-bottom: 0;
    }

    .nav-links a::after {
      display: none;
    }

    .nav-links a[aria-current='page'] {
      color: var(--heading);
      font-weight: 600;
    }
  }
</style>
