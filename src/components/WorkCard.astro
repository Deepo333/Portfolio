---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { url, type WorkSample } from '../lib/content';

interface Props {
  sample: WorkSample;
  /** Hide the category label when the card already sits under a category heading. */
  showCategory?: boolean;
  /** Show the one-sentence summary under the title. */
  showSummary?: boolean;
  /** Use "h2" when the card sits directly under the page title. */
  headingLevel?: 'h2' | 'h3';
}

const {
  sample,
  showCategory = true,
  showSummary = true,
  headingLevel: Heading = 'h3',
} = Astro.props;
const { title, summary, category, cover, coverAlt, placeholder } = sample.data;
---

<article class="work-card">
  <div class="cover">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[480, 720, 1080]}
      sizes="(max-width: 760px) 100vw, 400px"
    />
    {placeholder && <p class="placeholder-tag">Placeholder sample</p>}
  </div>
  <div class="body">
    {showCategory && <p class="label">{category}</p>}
    <Heading class="title">
      <a href={url(`/work/${sample.id}/`)}>{title}</a>
    </Heading>
    {showSummary && <p class="summary">{summary}</p>}
    <span class="more" aria-hidden="true">
      View sample
      <Icon name="arrow" size={16} />
    </span>
  </div>
</article>

<style>
  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .work-card:focus-within {
    outline: 2px solid var(--ink);
    outline-offset: 6px;
  }

  .cover {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--section);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }

  .work-card:hover .cover img {
    transform: scale(1.04);
  }

  :global(:root[data-theme='dark']) .cover img {
    filter: brightness(0.9);
  }

  .cover .placeholder-tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding-top: 1.5rem;
  }

  .body .label {
    margin-bottom: 0.75rem;
  }

  .title {
    font-size: clamp(1.5rem, 2.4vw, 1.875rem);
    line-height: 1.15;
  }

  .title a {
    color: var(--heading);
    text-decoration: none;
  }

  .title a:hover {
    opacity: 1;
  }

  /* Makes the whole card clickable while keeping a single link for screen readers. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .title a:focus-visible {
    outline: none;
  }

  .summary {
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-size: 0.96875rem;
    line-height: 1.65;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.25rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--border-strong);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .more :global(.icon) {
    transition: transform 0.35s var(--ease);
  }

  .work-card:hover .more :global(.icon) {
    transform: translateX(4px);
  }
</style>
