---
import { Image } from 'astro:assets';
import { url, type WorkSample } from '../lib/content';

interface Props {
  sample: WorkSample;
  /** Use "h2" when the card sits directly under the page title. */
  headingLevel?: 'h2' | 'h3';
  /** Hide the category label when the card already sits under a category heading. */
  showCategory?: boolean;
}

const { sample, headingLevel: Heading = 'h3', showCategory = true } = Astro.props;
const { title, summary, category, cover, coverAlt } = sample.data;
---

<article class="work-card">
  <div class="cover">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[400, 640, 960]}
      sizes="(max-width: 720px) 100vw, 360px"
    />
  </div>
  <div class="body">
    {showCategory && <p class="category">{category}</p>}
    <Heading class="title">
      <a href={url(`/work/${sample.id}/`)}>{title}</a>
    </Heading>
    <p class="summary">{summary}</p>
    <p class="more" aria-hidden="true">
      View sample
      <svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
    </p>
  </div>
</article>

<style>
  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .work-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .work-card:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .cover {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .work-card:hover .cover img {
    transform: scale(1.025);
  }

  :global(:root[data-theme='dark']) .cover img {
    filter: brightness(0.9);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .cover img {
      filter: brightness(0.9);
    }
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .category {
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .category + .title {
    margin-top: 0.5rem;
  }

  .title {
    font-size: 1.1875rem;
    line-height: 1.35;
  }

  .title a {
    color: var(--text);
    text-decoration: none;
  }

  /* Makes the whole card clickable while keeping a single link for screen readers. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .title a:focus-visible {
    outline: none;
  }

  .summary {
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: 0.96875rem;
    line-height: 1.6;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: auto;
    padding-top: 1.25rem;
    color: var(--accent);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .more svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease;
  }

  .work-card:hover .more svg {
    transform: translateX(3px);
  }
</style>
