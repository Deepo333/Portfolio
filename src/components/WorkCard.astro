---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { url, type WorkSample } from '../lib/content';

interface Props {
  sample: WorkSample;
  /** Hide the category label when the card already sits under a category heading. */
  showCategory?: boolean;
  /** Show the one-sentence summary under the title. */
  showSummary?: boolean;
  /** Use "h2" when the card sits directly under the page title. */
  headingLevel?: 'h2' | 'h3';
}

const {
  sample,
  showCategory = true,
  showSummary = true,
  headingLevel: Heading = 'h3',
} = Astro.props;
const { title, summary, category, cover, coverAlt, placeholder } = sample.data;
---

<article class="work-card">
  {
    (showCategory || placeholder) && (
      <div class="meta">
        {showCategory && <p class="label">{category}</p>}
        {placeholder && <p class="placeholder-tag">Placeholder sample</p>}
      </div>
    )
  }
  <Heading class="title">
    <a href={url(`/work/${sample.id}/`)}>{title}</a>
  </Heading>
  {showSummary && <p class="summary">{summary}</p>}
  <div class="cover">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[400, 640, 960]}
      sizes="(max-width: 640px) 80vw, (max-width: 1024px) 45vw, 380px"
    />
  </div>
  <span class="more" aria-hidden="true">
    View sample
    <Icon name="arrow" size={16} />
  </span>
</article>

<style>
  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
  }

  .work-card:focus-within {
    outline: 2px solid var(--ink);
    outline-offset: 6px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.75rem;
  }

  .title {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.2;
  }

  .title a {
    color: var(--heading);
    text-decoration: none;
  }

  .title a:hover {
    opacity: 1;
  }

  /* Makes the whole card clickable while keeping a single link for screen readers. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .title a:focus-visible {
    outline: none;
  }

  .summary {
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  /* The illustration sits below the text, never behind it. */
  .cover {
    width: 100%;
    aspect-ratio: 4 / 3;
    margin-top: auto;
    padding-top: 1rem;
    overflow: hidden;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--section);
    transition: transform 0.9s var(--ease-out);
  }

  .work-card:hover .cover img {
    transform: scale(1.03);
  }

  :global(:root[data-theme='dark']) .cover img {
    filter: brightness(0.9);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.9rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--border-strong);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .more :global(.icon) {
    transition: transform 0.35s var(--ease);
  }

  .work-card:hover .more :global(.icon) {
    transform: translateX(4px);
  }
</style>
