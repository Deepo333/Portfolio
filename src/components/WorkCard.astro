---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { url, type WorkSample } from '../lib/content';

interface Props {
  sample: WorkSample;
  /** Hide the category tag when the card already sits under a category heading. */
  showCategory?: boolean;
  /** Show the one-sentence summary under the title. */
  showSummary?: boolean;
  /** Use "h2" when the card sits directly under the page title. */
  headingLevel?: 'h2' | 'h3';
}

const {
  sample,
  showCategory = true,
  showSummary = true,
  headingLevel: Heading = 'h3',
} = Astro.props;
const { title, summary, category, cover, coverAlt } = sample.data;
---

<article class="work-card">
  <div class="cover">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[480, 720, 1080]}
      sizes="(max-width: 760px) 100vw, 380px"
    />
  </div>
  <div class="body">
    {showCategory && <p class="tag">{category}</p>}
    <div class="row">
      <div class="text">
        <Heading class="title">
          <a href={url(`/work/${sample.id}/`)}>{title}</a>
        </Heading>
        {showSummary && <p class="summary">{summary}</p>}
      </div>
      <span class="arrow" aria-hidden="true"><Icon name="arrow" size={20} /></span>
    </div>
  </div>
</article>

<style>
  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }

  .work-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-lg);
  }

  .work-card:focus-within {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }

  .cover {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: calc(var(--radius-lg) - 8px);
    background: var(--section);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .work-card:hover .cover img {
    transform: scale(1.03);
  }

  :global(:root[data-theme='dark']) .cover img {
    filter: brightness(0.92);
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.25rem 0.9rem 0.9rem;
  }

  .tag {
    margin-bottom: 0.85rem;
  }

  .row {
    display: flex;
    flex: 1;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
  }

  .text {
    align-self: flex-start;
  }

  .title {
    font-size: clamp(1.3125rem, 2vw, 1.5rem);
    line-height: 1.25;
  }

  .title a {
    color: var(--heading);
    text-decoration: none;
  }

  /* Makes the whole card clickable while keeping a single link for screen readers. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .title a:focus-visible {
    outline: none;
  }

  .summary {
    margin-top: 0.6rem;
    color: var(--text-muted);
    font-size: 0.96875rem;
    line-height: 1.6;
  }

  .arrow {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1.5px solid var(--border-strong);
    border-radius: 50%;
    color: var(--primary);
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease),
      color 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  .work-card:hover .arrow {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--on-primary);
    transform: translateX(2px);
  }
</style>
