---
/*
 * Your background-removed headshot (a "cutout"), with no frame or border, so it
 * blends into the page. The photo is set in content/pages/about.md.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** How wide the photo appears, for picking the right file size. */
  sizes: string;
  /** Load right away (use for the photo at the top of a page). */
  eager?: boolean;
  class?: string;
}

const { src, alt, sizes, eager = false, class: className } = Astro.props;
// Never enlarge the photo beyond its original size.
const widths = [480, 720, src.width].filter((w, i, all) => w <= src.width && all.indexOf(w) === i);
---

<Image
  class:list={['cutout', className]}
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={95}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
/>

<style>
  .cutout {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
  }
</style>
