---
/*
 * A two-column cover: your text on the left, your cutout photo on the right.
 * The photo is a PNG with a transparent background, so it sits directly on
 * the section's background (--hero-bg in src/styles/global.css). The photo
 * rests on the bottom of the section, and its top edge (where your hair runs
 * off the photo) fades softly into the background. On phones the photo sits
 * on top and its bottom edge fades too, so it blends into the text below.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** The id of the heading that names this section. */
  labelledby?: string;
}

const { src, alt, labelledby } = Astro.props;
const widths = [400, 640, src.width].filter((w, i, all) => w <= src.width && all.indexOf(w) === i);
---

<section class="photo-cover" aria-labelledby={labelledby}>
  <div class="photo-cover-text">
    <slot />
  </div>
  <div class="photo-cover-photo">
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes="(max-width: 760px) 340px, 560px"
      quality={90}
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .photo-cover {
    --edge: max(var(--gutter), calc((100vw - var(--page-width)) / 2));

    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    background: var(--hero-bg);
    color: var(--ink);
  }

  .photo-cover-text {
    align-self: center;
    padding-block: clamp(2.5rem, 6vw, 5rem);
    padding-inline: var(--edge) clamp(1rem, 3vw, 3rem);
  }

  .photo-cover-photo {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-right: var(--edge);
  }

  .photo-cover-photo img {
    display: block;
    width: 100%;
    max-width: 560px;
    height: auto;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 7%);
    mask-image: linear-gradient(to bottom, transparent, #000 7%);
  }

  @media (max-width: 760px) {
    .photo-cover {
      grid-template-columns: minmax(0, 1fr);
    }

    .photo-cover-photo {
      order: -1;
      padding: 0 var(--gutter);
    }

    .photo-cover-photo img {
      max-width: 340px;
      /* The text follows the photo here, so the photo's bottom edge fades out too. */
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 7%, #000 78%, transparent);
      mask-image: linear-gradient(to bottom, transparent, #000 7%, #000 78%, transparent);
    }

    /* The text starts below the photo so it never covers it. */
    .photo-cover-text {
      padding: 0.5rem var(--gutter) clamp(2.5rem, 8vw, 3.5rem);
    }
  }
</style>
