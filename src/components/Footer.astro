---
import { url } from '../lib/content';

interface Props {
  settings: {
    name: string;
    role: string;
    email: string;
    linkedin: string;
    sourceCode?: string;
  };
}

const { settings } = Astro.props;
const year = new Date().getFullYear();

// Every page on the site, so each one is always reachable from the footer.
const pages = [
  { label: 'Home', href: '/' },
  { label: 'Work samples', href: '/work/' },
  { label: 'About', href: '/about/' },
  { label: 'Résumé', href: '/resume/' },
  { label: 'Contact', href: '/contact/' },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="identity">
      <a class="footer-name" href={url('/')}>{settings.name}</a>
      <p>{settings.role}</p>
    </div>
    <nav class="footer-pages" aria-label="All pages">
      <ul class="footer-links">
        {
          pages.map((page) => (
            <li>
              <a href={url(page.href)}>{page.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ul class="footer-links footer-contact">
      <li><a href={`mailto:${settings.email}`}>Email</a></li>
      <li><a href={settings.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
      {
        settings.sourceCode && (
          <li>
            <a href={settings.sourceCode} rel="noopener" target="_blank">
              Built as docs-as-code
            </a>
          </li>
        )
      }
    </ul>
    <p class="copyright">© {year} {settings.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem 2rem;
    padding-block: 2.5rem 2rem;
  }

  .footer-pages {
    grid-column: 1 / -1;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .identity {
    grid-row: 1;
  }

  .footer-contact {
    grid-row: 1;
    justify-content: flex-end;
  }

  .footer-name {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .identity p {
    margin-top: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    display: inline-block;
    padding-block: 0.45rem;
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .footer-links a:hover {
    text-decoration: underline;
    opacity: 1;
  }

  .copyright {
    grid-column: 1 / -1;
    font-size: 0.8125rem;
  }

  @media (max-width: 640px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }

    .footer-contact {
      grid-row: auto;
      justify-content: flex-start;
    }
  }
</style>
