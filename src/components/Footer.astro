---
import { url } from '../lib/content';

interface Props {
  settings: {
    name: string;
    role: string;
    email: string;
    linkedin: string;
    sourceCode?: string;
  };
}

const { settings } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="identity">
      <a class="footer-name" href={url('/')}>{settings.name}</a>
      <p>{settings.role}</p>
    </div>
    <ul class="footer-links">
      <li><a href={`mailto:${settings.email}`}>Email</a></li>
      <li><a href={settings.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
      {
        settings.sourceCode && (
          <li>
            <a href={settings.sourceCode} rel="noopener" target="_blank">
              Built as docs-as-code
            </a>
          </li>
        )
      }
    </ul>
    <p class="copyright">© {year} {settings.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1.25rem 2rem;
    padding-block: 2.75rem;
  }

  .footer-name {
    color: var(--heading);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-variation-settings: 'SOFT' 100, 'WONK' 0;
    text-decoration: none;
  }

  .identity p {
    margin-top: 0.15rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--primary);
    text-decoration: underline;
  }

  .copyright {
    grid-column: 1 / -1;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    color: var(--text-subtle);
    font-size: 0.875rem;
  }

  @media (max-width: 640px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
