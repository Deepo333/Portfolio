---
/*
 * Your headshot in an arch-shaped frame with a soft blush accent behind it.
 * The photo is set in content/pages/about.md.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Load right away (use for the photo at the top of a page). */
  eager?: boolean;
  class?: string;
}

const { src, alt, eager = false, class: className } = Astro.props;
---

<figure class:list={['portrait', className]}>
  <span class="accent" aria-hidden="true"></span>
  <div class="frame">
    <Image
      src={src}
      alt={alt}
      widths={[640, 960, Math.min(src.width, 1600)]}
      sizes="(max-width: 860px) 420px, 680px"
      quality={90}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  </div>
</figure>

<style>
  .portrait {
    position: relative;
    margin: 0;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 4 / 5;
    isolation: isolate;
  }

  .frame {
    position: relative;
    height: 100%;
    overflow: hidden;
    border: 8px solid var(--surface);
    border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
    background: var(--section);
    box-shadow: var(--shadow-lg);
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keeps the face centered when the photo is cropped to the arch shape. */
    object-position: 51% 30%;
  }

  /* Soft blush arch, offset behind the photo. */
  .accent {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
    background: var(--blush);
    opacity: 0.55;
    transform: translate(7%, 5%);
  }
</style>
