---
/*
 * A card in "Featured work" on the home page: a category name, one line about
 * it, and the cover of one sample from that category. The whole card opens
 * that category on the Work Samples page. Set them in content/home/featured.md.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { categoryHref, type WorkSample } from '../lib/content';

interface Props {
  sample: WorkSample;
  description: string;
  /** Seconds to wait before the card fades in, to stagger cards in a row. */
  revealDelay?: number;
}

const { sample, description, revealDelay = 0 } = Astro.props;
const { category, cover, coverAlt } = sample.data;
---

<article class="featured-card" data-reveal style={`--reveal-delay: ${revealDelay}s`}>
  <h3 class="category">
    <a href={categoryHref(category)}>{category}</a>
  </h3>
  <p class="description">{description}</p>
  <div class="cover">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[400, 640, 960]}
      sizes="(max-width: 640px) 80vw, (max-width: 1024px) 45vw, 380px"
    />
  </div>
  <span class="more" aria-hidden="true">
    View samples
    <Icon name="arrow" size={16} />
  </span>
</article>

<style>
  .featured-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
  }

  .featured-card:focus-within {
    outline: 2px solid var(--ink);
    outline-offset: 6px;
  }

  .category a {
    color: var(--heading);
    text-decoration: none;
  }

  .category a:hover {
    opacity: 1;
  }

  /* The heading's link covers the whole card. */
  .category a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .category a:focus-visible {
    outline: none;
  }

  .description {
    margin-top: 0.4rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  .cover {
    width: 100%;
    aspect-ratio: 4 / 3;
    margin-top: auto;
    padding-top: 1rem;
    overflow: hidden;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--section);
    transition: transform 0.9s var(--ease-out);
  }

  .featured-card:hover .cover img {
    transform: scale(1.03);
  }

  :global(:root[data-theme='dark']) .cover img {
    filter: brightness(0.9);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.9rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--border-strong);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .more :global(.icon) {
    transition: transform 0.35s var(--ease);
  }

  .featured-card:hover .more :global(.icon) {
    transform: translateX(4px);
  }

  /* With a mouse or trackpad, the card lifts slightly on hover. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .featured-card:hover {
      transform: translateY(-4px);
    }
  }
</style>
