---
/* About page. The words and headshot come from content/pages/about.md. */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage, url } from '../lib/content';

const page = await getPage('about');
const { Content } = await render(page);
const { title, description, headshot, headshotAlt } = page.data;
---

<BaseLayout title={title} description={description}>
  <div class="container about">
    {
      headshot && (
        <div class="headshot">
          <Image
            src={headshot}
            alt={headshotAlt ?? ''}
            widths={[320, 480, 720]}
            sizes="(max-width: 800px) 240px, 320px"
            loading="eager"
          />
        </div>
      )
    }
    <div class="about-text">
      <h1>{title}</h1>
      <div class="prose">
        <Content />
      </div>
      <div class="button-row">
        <a class="button button-primary" href={url('/resume/')}>View résumé</a>
        <a class="button button-secondary" href={url('/contact/')}>Get in touch</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    padding-block: clamp(3rem, 9vw, 6rem) 0;
  }

  .headshot {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: 24px;
    border: 1px solid var(--border);
    background: var(--bg-subtle);
  }

  .headshot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1 {
    margin-bottom: 1.5rem;
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    letter-spacing: -0.035em;
  }

  .prose :global(p:first-of-type) {
    color: var(--text-muted);
    font-size: 1.1875rem;
  }

  .button-row {
    margin-top: 2.5rem;
  }

  @media (max-width: 800px) {
    .about {
      grid-template-columns: 1fr;
    }

    .headshot {
      position: static;
      width: min(240px, 70%);
    }
  }
</style>
