---
/* About page. The words and photo come from content/pages/about.md. */
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Letters from '../components/Letters.astro';
import Typewriter from '../components/Typewriter.astro';
import { Image } from 'astro:assets';
import { getPage, getSettings, plainText, url } from '../lib/content';

const settings = await getSettings();
const page = await getPage('about');
const { Content } = await render(page);
const { title, description, lead, headshot, headshotAlt } = page.data;
const widths = headshot
  ? [640, 960, headshot.width].filter((w, i, all) => w <= headshot.width && all.indexOf(w) === i)
  : [];
---

<BaseLayout title={plainText(title)} description={description}>
  {
    headshot ? (
      <section
        class="about-hero"
        aria-labelledby="about-title"
        style={`--photo-ratio: ${headshot.width} / ${headshot.height}`}
      >
        <div class="about-heading">
          <h1 id="about-title" class="about-title page-title typed" data-replay>
            <Typewriter text={plainText(title)} />
          </h1>
          {lead && <p class="about-lead">{lead}</p>}
        </div>
        <div class="about-text">
          <div class="button-row">
            <a class="button button-secondary" href={url('/contact/')}>
              Get in touch
            </a>
          </div>
        </div>
        <div class="about-photo">
          <Image
            src={headshot}
            alt={headshotAlt ?? settings.name}
            widths={widths}
            sizes="(max-width: 760px) 100vw, 50vw"
            quality={90}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </section>
    ) : (
      <header class="page-header container">
        <h1 class="about-title page-title" data-reveal="letters">
          <Letters text={plainText(title)} />
        </h1>
        {lead && <p class="lead">{lead}</p>}
      </header>
    )
  }

  <section class="band container about-body" aria-label="Professional summary">
    <p class="label">Professional summary</p>
    <div class="prose">
      <Content />
    </div>
  </section>
</BaseLayout>

<style>
  /* Heading and text on the left, photo on the right, on the same grey as the photo.
     On phones the order is heading, photo, then the text. */
  .about-hero {
    /* The photo's background is a light grey, so this section stays light in dark mode. */
    color-scheme: light;
    --photo-w: clamp(420px, 50vw, 960px);
    --text-muted: #4a4643;
    --accent-text: #5a4a3c;
    --edge: max(var(--gutter), calc((100vw - var(--page-width)) / 2));

    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--photo-w);
    grid-template-rows: 1fr auto;
    grid-template-areas:
      'heading photo'
      'text photo';
    min-height: calc(var(--photo-w) / (var(--photo-ratio)));
    background: var(--hero-bg);
    color: var(--ink);
  }

  /* "About" stacked over "me", sized from the column width so it fits on every screen. */
  .about-heading {
    grid-area: heading;
    align-self: center;
    container-type: inline-size;
    /* The typing cursor can sit just past the word; don't let it widen the page. */
    overflow-x: clip;
    padding: clamp(1rem, 3vw, 2.5rem) clamp(1.5rem, 4vw, 4rem) 0 var(--edge);
  }

  .about-title {
    font-size: 36cqi;
    line-height: 0.85;
    letter-spacing: 0;
  }

  .about-text {
    grid-area: text;
    padding: 0 clamp(1.5rem, 4vw, 4rem) clamp(1.5rem, 4vw, 3rem) var(--edge);
  }

  .about-photo {
    grid-area: photo;
    position: relative;
  }

  .about-photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 0;
    /* Fade the left edge (studio background only) into the matching grey. */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 16%);
    mask-image: linear-gradient(to right, transparent, #000 16%);
  }

  @media (max-width: 760px) {
    .about-hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      grid-template-areas:
        'heading'
        'photo'
        'text';
      min-height: 0;
    }

    .about-heading {
      padding: 1rem var(--gutter) 0.75rem;
    }

    .about-text {
      padding: 1rem var(--gutter) clamp(2.5rem, 8vw, 3.5rem);
    }

    .about-photo {
      aspect-ratio: var(--photo-ratio);
    }

    .about-photo :global(img) {
      object-position: 50% 0;
      /* The photo spans the screen, so its bottom edge fades into the text below. */
      -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent);
      mask-image: linear-gradient(to bottom, #000 70%, transparent);
    }
  }

  .about-lead {
    /* Two lines of text below "me" (and clear of the typing cursor), starting at the
       same left edge as the heading. */
    margin-top: 3.5rem;
    max-width: 46ch;
    color: var(--text-muted);
  }

  .button-row {
    margin-top: 1.75rem;
  }

  .about-body {
    display: grid;
    grid-template-columns: minmax(0, 0.5fr) minmax(0, 1.5fr);
    gap: 1.25rem clamp(2rem, 6vw, 6rem);
  }

  .about-body .label {
    padding-top: 0.5rem;
  }

  @media (max-width: 860px) {
    .about-body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
