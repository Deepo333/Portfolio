---
/* About page. The words and photo come from content/pages/about.md. */
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Letters from '../components/Letters.astro';
import Icon from '../components/Icon.astro';
import PhotoCover from '../components/PhotoCover.astro';
import { getPage, getSettings, plainText, url } from '../lib/content';

const settings = await getSettings();
const page = await getPage('about');
const resume = await getPage('resume');
const { Content } = await render(page);
const { title, description, lead, headshot, headshotAlt } = page.data;
---

<BaseLayout title={plainText(title)} description={description}>
  {
    headshot ? (
      <div class="about-cover">
        <div class="container about-heading">
          <h1 id="about-title" class="about-title page-title" data-reveal="letters">
            <Letters text={plainText(title)} />
          </h1>
        </div>
      </div>
      <PhotoCover
        src={headshot}
        alt={headshotAlt ?? settings.name}
        labelledby="about-title"
        fadeTop
      >
        {lead && <p class="about-lead">{lead}</p>}
        <div class="button-row">
          <a
            class="button button-primary"
            href={resume.data.pdf ? url(resume.data.pdf) : url('/resume/')}
            download={resume.data.pdf ? `${settings.name} - Resume.pdf` : undefined}
            target={resume.data.pdf ? '_blank' : undefined}
            rel={resume.data.pdf ? 'noopener' : undefined}
          >
            <Icon name="download" />
            Download résumé
          </a>
          <a class="button button-secondary" href={url('/contact/')}>
            Get in touch
          </a>
        </div>
      </PhotoCover>
    ) : (
      <header class="page-header container">
        <h1 class="about-title page-title" data-reveal="letters">
          <Letters text={plainText(title)} />
        </h1>
        {lead && <p class="lead">{lead}</p>}
      </header>
    )
  }

  <section class="band container about-body" aria-label="Professional summary">
    <p class="label">Professional summary</p>
    <div class="prose">
      <Content />
    </div>
  </section>
</BaseLayout>

<style>
  /* The heading spans the top of the page like a magazine cover, on the same
     grey as the photo section below it. */
  .about-cover {
    color-scheme: light;
    background: var(--hero-bg);
    color: var(--ink);
  }

  .about-heading {
    container-type: inline-size;
    padding-top: clamp(0.75rem, 2.5vw, 2rem);
  }

  /* Abril Fatface is about 4.35 em wide for "About me", so this size fills the
     width of the page, and shrinks with it on phones. */
  .about-title {
    font-size: 22.6cqi;
    line-height: 0.95;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .about-lead {
    margin-top: 1.25rem;
    max-width: 46ch;
    color: var(--text-muted);
  }

  .button-row {
    margin-top: 1.75rem;
  }

  .about-body {
    display: grid;
    grid-template-columns: minmax(0, 0.5fr) minmax(0, 1.5fr);
    gap: 1.25rem clamp(2rem, 6vw, 6rem);
  }

  .about-body .label {
    padding-top: 0.5rem;
  }

  @media (max-width: 860px) {
    .about-body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
