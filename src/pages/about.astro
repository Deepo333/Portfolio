---
/* About page. The words and photo come from content/pages/about.md. */
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Accent from '../components/Accent.astro';
import Icon from '../components/Icon.astro';
import PhotoCover from '../components/PhotoCover.astro';
import { getPage, getSettings, plainText, url } from '../lib/content';

const settings = await getSettings();
const page = await getPage('about');
const resume = await getPage('resume');
const { Content } = await render(page);
const { title, description, lead, headshot, headshotAlt } = page.data;
---

<BaseLayout title={plainText(title)} description={description}>
  {
    headshot ? (
      <PhotoCover src={headshot} alt={headshotAlt ?? settings.name} labelledby="about-title">
        <h1 id="about-title" class="about-title">
          <Accent text={title} />
        </h1>
        {lead && <p class="about-lead">{lead}</p>}
        <div class="button-row">
          <a
            class="button button-primary"
            href={resume.data.pdf ? url(resume.data.pdf) : url('/resume/')}
            download={resume.data.pdf ? `${settings.name} - Resume.pdf` : undefined}
            target={resume.data.pdf ? '_blank' : undefined}
            rel={resume.data.pdf ? 'noopener' : undefined}
          >
            <Icon name="download" />
            Download résumé
          </a>
          <a class="button button-secondary" href={url('/contact/')}>
            Get in touch
          </a>
        </div>
      </PhotoCover>
    ) : (
      <header class="page-header container">
        <h1 class="about-title">
          <Accent text={title} />
        </h1>
        {lead && <p class="lead">{lead}</p>}
      </header>
    )
  }

  <section class="band container about-body" aria-label="Biography" data-reveal>
    <p class="label">Biography</p>
    <div class="prose">
      <Content />
    </div>
  </section>
</BaseLayout>

<style>
  .about-title {
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 7vw, 7rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 0.85;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .about-title :global(.script) {
    display: inline-block;
    margin-left: 0.04em;
    color: var(--accent-large);
    font-size: 0.9em;
    line-height: 0.5;
    transform: rotate(-5deg) translateY(0.1em);
  }

  .about-lead {
    margin-top: clamp(1.5rem, 3vw, 2rem);
    max-width: 30ch;
    font-family: var(--font-heading);
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    line-height: 1.3;
  }

  .button-row {
    margin-top: 1.75rem;
  }

  .about-body {
    display: grid;
    grid-template-columns: minmax(0, 0.5fr) minmax(0, 1.5fr);
    gap: 1.25rem clamp(2rem, 6vw, 6rem);
  }

  .about-body .label {
    padding-top: 0.5rem;
  }

  .prose :global(p:first-child) {
    font-size: 1.1875rem;
  }

  @media (max-width: 860px) {
    .about-body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
