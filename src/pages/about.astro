---
/* About page. The words and headshot come from content/pages/about.md. */
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Portrait from '../components/Portrait.astro';
import { getPage, getSettings, url } from '../lib/content';

const settings = await getSettings();
const page = await getPage('about');
const resume = await getPage('resume');
const { Content } = await render(page);
const { title, description, headshot, headshotAlt } = page.data;
---

<BaseLayout title={title} description={description}>
  <div class="container about">
    {
      headshot && (
        <div class="portrait-column">
          <Portrait src={headshot} alt={headshotAlt ?? settings.name} eager />
        </div>
      )
    }
    <div class="about-text">
      <h1>{title}</h1>
      <div class="prose">
        <Content />
      </div>
      <div class="button-row">
        <a
          class="button button-primary"
          href={resume.data.pdf ? url(resume.data.pdf) : url('/resume/')}
          download={resume.data.pdf ? `${settings.name} - Resume.pdf` : undefined}
        >
          <Icon name="download" />
          Download résumé
        </a>
        <a class="button button-secondary" href={url('/contact/')}>Get in touch</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
    padding-block: clamp(3rem, 8vw, 6rem) var(--section-space);
  }

  .portrait-column {
    position: sticky;
    top: calc(var(--header-height) + 2.5rem);
    padding-right: 7%;
  }

  h1 {
    margin-bottom: 1.75rem;
    font-size: clamp(2.5rem, 5.5vw, 3.75rem);
    font-variation-settings: 'SOFT' 100, 'WONK' 0;
    font-weight: 450;
  }

  .prose :global(p:first-of-type) {
    color: var(--text-muted);
    font-size: clamp(1.1875rem, 2vw, 1.3125rem);
    line-height: 1.6;
  }

  .button-row {
    margin-top: 2.75rem;
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }

    .portrait-column {
      position: static;
      width: min(68%, 300px);
      margin-left: 4%;
      padding-right: 0;
    }
  }
</style>
