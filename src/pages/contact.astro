---
/*
 * Contact page. The words come from content/pages/contact.md.
 * Your email address and LinkedIn link come from content/settings.md.
 */
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Accent from '../components/Accent.astro';
import Icon from '../components/Icon.astro';
import { getPage, getSettings, plainText } from '../lib/content';

const settings = await getSettings();
const page = await getPage('contact');
const { Content } = await render(page);
const { title, description, availability } = page.data;
const linkedinHandle = settings.linkedin
  .replace(/^https?:\/\/(www\.)?/, '')
  .replace(/\/$/, '');
---

<BaseLayout title={plainText(title)} description={description}>
  <header class="page-header container">
    {
      availability && (
        <p class="label availability">
          <span class="dot" aria-hidden="true" />
          {availability}
        </p>
      )
    }
    <h1><Accent text={title} /></h1>
    <div class="lead prose">
      <Content />
    </div>
  </header>

  <section class="container contact" aria-label="Contact options">
    <ul class="contact-list">
      <li>
        <a class="contact-row" href={`mailto:${settings.email}`}>
          <span class="label">Email</span>
          <span class="value">{settings.email}</span>
          <Icon name="arrow" />
        </a>
      </li>
      <li>
        <a class="contact-row" href={settings.linkedin} target="_blank" rel="me noopener">
          <span class="label">LinkedIn</span>
          <span class="value">{linkedinHandle}</span>
          <Icon name="external" />
        </a>
      </li>
    </ul>
    {settings.location && <p class="label location">Based in {settings.location}</p>}
  </section>
</BaseLayout>

<style>
  h1 :global(.script) {
    color: var(--accent-large);
    font-size: 1.1em;
    text-transform: none;
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .dot {
    width: 7px;
    height: 7px;
    background: var(--accent);
  }

  .contact {
    padding-bottom: var(--section-space);
  }

  .contact-list {
    max-width: 900px;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border-strong);
  }

  .contact-row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem 2rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--border-strong);
    color: var(--ink);
    text-decoration: none;
  }

  .contact-row:hover {
    opacity: 1;
  }

  .contact-row .label {
    color: var(--text-muted);
  }

  .value {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    font-weight: 400;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .contact-row :global(.icon) {
    transition: transform 0.35s var(--ease);
  }

  .contact-row:hover :global(.icon) {
    transform: translateX(4px);
  }

  .contact-row:hover .value {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .location {
    margin-top: 2rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .contact-row {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .contact-row .label {
      grid-column: 1 / -1;
    }
  }
</style>
