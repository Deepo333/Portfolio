---
/*
 * Template for every work sample detail page.
 * One page is created for each file in content/work/. The file name becomes
 * the web address: content/work/onboarding-guide.md -> /work/onboarding-guide/
 */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackBar from '../../components/BackBar.astro';
import Icon from '../../components/Icon.astro';
import PdfViewer from '../../components/PdfViewer.astro';
import {
  categoryHref,
  formatDate,
  getWorkSamples,
  url,
  type WorkSample,
} from '../../lib/content';

export async function getStaticPaths() {
  const samples = await getWorkSamples();
  return samples.map((sample, index) => ({
    params: { id: sample.id },
    props: {
      sample,
      newer: samples[index - 1],
      older: samples[index + 1],
    },
  }));
}

interface Props {
  sample: WorkSample;
  newer?: WorkSample;
  older?: WorkSample;
}

const { sample, newer, older } = Astro.props;
const { title, summary, category, date, role, audience, tools, pdf, images, link, placeholder } =
  sample.data;
const { Content, headings } = await render(sample);

const hasSample = Boolean(pdf || images.length > 0 || link);
const toc = [
  ...headings.filter((heading) => heading.depth === 2),
  ...(hasSample ? [{ slug: 'the-sample', text: 'The sample' }] : []),
];

// "All work samples" and "Home" appear at the top and bottom of every sample page.
const sampleLinks = [
  { label: 'All work samples', href: '/work/', icon: 'back' as const },
  { label: 'Home', href: '/', icon: 'home' as const },
];

const facts = [
  { label: 'Category', value: category },
  { label: 'My role', value: role },
  { label: 'Audience', value: audience },
  { label: 'Tools', value: tools.join(', ') },
  { label: 'Date', value: formatDate(date) },
].filter((fact) => fact.value);
---

<BaseLayout
  title={placeholder ? `${title} (placeholder sample)` : title}
  description={summary}
  backLinks={sampleLinks}
>
  <article>
    <header class="page-header container detail-header">
      <p class="label category-link">
        <a href={categoryHref(category)}>{category}</a>
      </p>
      <h1>{title}</h1>
      <p class="lead">{summary}</p>
      {
        placeholder && (
          <p class="placeholder-notice">
            <span class="placeholder-tag">Placeholder sample</span>
            This example shows how a work sample page is laid out. It is not real work.
          </p>
        )
      }
    </header>

    <div class="container detail-layout">
      <aside class="detail-aside">
        <dl class="facts">
          {
            facts.map((fact) => (
              <div>
                <dt class="label">{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>

        {
          toc.length > 1 && (
            <nav class="toc" aria-label="On this page">
              <p class="label">On this page</p>
              <ul>
                {toc.map((heading) => (
                  <li>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </aside>

      <div class="detail-main">
        <div class="prose">
          <Content />
        </div>

        {
          hasSample && (
            <section class="sample" aria-labelledby="the-sample" data-reveal>
              <h2 id="the-sample">The sample</h2>

              {pdf && <PdfViewer src={pdf} title={title} />}

              {images.length > 0 && (
                <div class="gallery">
                  {images.map((image) => (
                    <figure>
                      <a href={image.src.src} target="_blank" rel="noopener">
                        <Image
                          src={image.src}
                          alt={image.alt}
                          widths={[640, 1024, 1600]}
                          sizes="(max-width: 1120px) 100vw, 760px"
                        />
                        <span class="visually-hidden">(opens full size in a new tab)</span>
                      </a>
                      {image.caption && <figcaption>{image.caption}</figcaption>}
                    </figure>
                  ))}
                </div>
              )}

              {link && (
                <p class="external">
                  <a class="button button-secondary" href={link.url} target="_blank" rel="noopener">
                    {link.label}
                    <Icon name="external" />
                  </a>
                </p>
              )}
            </section>
          )
        }
      </div>
    </div>

    <BackBar
      class="sample-end-links"
      back={false}
      links={sampleLinks}
      label="Sample navigation"
    />

    <nav class="container pager" aria-label="More work samples">
      {
        newer && (
          <a class="pager-link" href={url(`/work/${newer.id}/`)} rel="prev">
            <span class="label">Previous sample</span>
            <span class="pager-title">{newer.data.title}</span>
          </a>
        )
      }
      {
        older && (
          <a class="pager-link next" href={url(`/work/${older.id}/`)} rel="next">
            <span class="label">Next sample</span>
            <span class="pager-title">{older.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .detail-header {
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  /* Sample titles use the serif, like a magazine feature headline. */
  .detail-header h1 {
    max-width: 18ch;
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.05;
    text-transform: none;
  }

  .category-link {
    margin-bottom: 1.25rem;
  }

  .category-link a {
    color: var(--accent-text);
    text-decoration: none;
  }

  .category-link a:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }

  /* The shared link row (a separate component) at the end of the sample. */
  :global(.sample-end-links) {
    margin-top: clamp(3rem, 7vw, 4.5rem);
  }

  .placeholder-notice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    max-width: 60ch;
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--ink);
    color: var(--ink);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .detail-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--border-strong);
  }

  .detail-aside {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    display: grid;
    gap: 2.5rem;
  }

  .detail-main {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }

  .facts {
    display: grid;
    margin: 0;
  }

  .facts > div {
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  .facts > div:first-child {
    padding-top: 0;
  }

  .facts dd {
    margin: 0.35rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .toc .label {
    margin-bottom: 0.9rem;
  }

  .toc ul {
    display: grid;
    gap: 0.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc a {
    display: block;
    padding: 0.3rem 0 0.3rem 1rem;
    border-left: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.9375rem;
    text-decoration: none;
    transition:
      border-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .toc a:hover {
    opacity: 1;
    border-left-color: var(--ink);
    color: var(--ink);
  }

  .sample {
    margin-top: clamp(3.5rem, 8vw, 5rem);
  }

  .sample h2 {
    margin-bottom: 1.75rem;
    font-size: clamp(2rem, 4vw, 2.75rem);
  }

  .gallery {
    display: grid;
    gap: 2.5rem;
  }

  .gallery + .external,
  :global(.pdf-viewer) + .gallery,
  :global(.pdf-viewer) + .external {
    margin-top: 2.5rem;
  }

  .gallery figure {
    margin: 0;
  }

  .gallery a {
    display: block;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .gallery a:hover {
    opacity: 1;
  }

  .gallery img {
    width: 100%;
  }

  .gallery figcaption {
    margin-top: 0.9rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 2rem;
    padding-block: 1.5rem var(--section-space);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-strong);
    color: var(--ink);
    text-decoration: none;
  }

  .pager-link:hover {
    opacity: 1;
  }

  .pager-link:hover .pager-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .pager-link.next {
    grid-column: 2;
    text-align: right;
  }

  .pager-title {
    font-family: var(--font-heading);
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    line-height: 1.2;
  }

  @media (max-width: 900px) {
    .detail-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .detail-aside,
    .detail-main {
      grid-column: 1;
      grid-row: auto;
    }

    .detail-aside {
      position: static;
    }

    .facts {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      column-gap: 1.5rem;
    }

    .facts > div:first-child {
      padding-top: 0.9rem;
    }

    .toc {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
      row-gap: 2rem;
    }

    .pager-link.next {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
