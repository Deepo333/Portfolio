---
/*
 * Work Samples hub. The title, intro, and category list come from
 * content/pages/work.md. Each card is a file in content/work/.
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryBand from '../../components/CategoryBand.astro';
import Letters from '../../components/Letters.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getCategories, getPage, getWorkSamples } from '../../lib/content';

const page = await getPage('work');
const { Content } = await render(page);
const samples = await getWorkSamples();
const groups = (await getCategories())
  .map((category) => ({
    ...category,
    samples: samples.filter((sample) => sample.data.category === category.name),
  }))
  .filter((group) => group.samples.length > 0);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <header class="page-header container">
    <h1 class="page-title" data-reveal="letters"><Letters text={page.data.title} /></h1>
    <div class="lead prose">
      <Content />
    </div>
  </header>

  <CategoryBand
    categories={groups.map((group) => ({ name: group.name, count: group.samples.length }))}
    label="Jump to a category"
  />

  {
    groups.map((group) => (
      <section
        class="category container"
        id={group.slug}
        aria-labelledby={`${group.slug}-heading`}
      >
        <div class="category-heading" data-reveal>
          <h2 id={`${group.slug}-heading`}>{group.name}</h2>
          <p>{group.description}</p>
        </div>
        <div class="category-grid">
          {group.samples.map((sample, index) => (
            <WorkCard sample={sample} showCategory={false} revealDelay={(index % 2) * 0.08} />
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .category {
    scroll-margin-top: var(--header-height);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2rem clamp(2rem, 6vw, 6rem);
    align-items: start;
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .category + .category {
    border-top: 1px solid var(--border);
  }

  .category:last-of-type {
    padding-bottom: var(--section-space);
  }

  .category-heading {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
  }

  .category-heading p {
    margin-top: 1rem;
    max-width: 34ch;
    color: var(--text-muted);
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: clamp(2rem, 4vw, 3rem);
  }

  /* Smaller screens: the category name runs across the top, with its
     description and sample cards side by side underneath. */
  @media (max-width: 860px) {
    .category {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      gap: 0.75rem 1.25rem;
    }

    .category-heading {
      display: contents;
    }

    .category-heading h2 {
      grid-column: 1 / -1;
    }

    .category-heading p {
      margin-top: 0;
    }

    .category-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    /* The category description sits beside the card, so skip the card's summary. */
    .category-grid :global(.summary) {
      display: none;
    }
  }
</style>
