---
/*
 * Work Samples hub. The title, intro, and category list come from
 * content/pages/work.md. Each card is a file in content/work/.
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryBand from '../../components/CategoryBand.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getCategories, getPage, getWorkSamples } from '../../lib/content';

const page = await getPage('work');
const { Content } = await render(page);
const samples = await getWorkSamples();
const groups = (await getCategories())
  .map((category) => ({
    ...category,
    samples: samples.filter((sample) => sample.data.category === category.name),
  }))
  .filter((group) => group.samples.length > 0);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <header class="page-header container">
    <h1>{page.data.title}</h1>
    <div class="lead prose">
      <Content />
    </div>
  </header>

  <CategoryBand
    categories={groups.map((group) => ({ name: group.name, count: group.samples.length }))}
    label="Jump to a category"
  />

  {
    groups.map((group) => (
      <section
        class="category container"
        id={group.slug}
        aria-labelledby={`${group.slug}-heading`}
        data-reveal
      >
        <div class="category-heading">
          <h2 id={`${group.slug}-heading`}>{group.name}</h2>
          <p>{group.description}</p>
        </div>
        <div class="category-grid">
          {group.samples.map((sample) => (
            <WorkCard sample={sample} showCategory={false} />
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .category {
    scroll-margin-top: var(--header-height);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2rem clamp(2rem, 6vw, 6rem);
    align-items: start;
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .category + .category {
    border-top: 1px solid var(--border);
  }

  .category:last-of-type {
    padding-bottom: var(--section-space);
  }

  .category-heading {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
  }

  .category-heading h2 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .category-heading p {
    margin-top: 1rem;
    max-width: 34ch;
    color: var(--text-muted);
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: clamp(2rem, 4vw, 3rem);
  }

  @media (max-width: 860px) {
    .category {
      grid-template-columns: minmax(0, 1fr);
    }

    .category-heading {
      position: static;
    }
  }
</style>
