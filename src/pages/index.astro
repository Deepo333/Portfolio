---
/*
 * Home page. Every word on this page comes from a Markdown file:
 *   content/settings.md              your name, job title, email, and LinkedIn
 *   content/home/intro.md            hero tagline, intro, and button labels
 *   content/home/stats.md            the four stats
 *   content/home/featured.md         featured work heading and which samples to show
 *   content/home/capabilities.md     core capabilities
 *   content/home/tools.md            tools & technologies, in groups
 *   content/home/process.md          my process
 *   content/home/closing.md          the "Let's work together" band
 *   content/pages/about.md           your photo
 *   content/pages/work.md            the categories in the black band
 */
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Accent from '../components/Accent.astro';
import CategoryBand from '../components/CategoryBand.astro';
import Icon from '../components/Icon.astro';
import PhotoCover from '../components/PhotoCover.astro';
import WorkCard from '../components/WorkCard.astro';
import {
  getCategories,
  getFeaturedSamples,
  getHomeSection,
  getPage,
  getSettings,
  getWorkSamples,
  url,
} from '../lib/content';

const settings = await getSettings();
const [intro, stats, featured, capabilities, tools, process, closing] = await Promise.all([
  getHomeSection('homeIntro'),
  getHomeSection('homeStats'),
  getHomeSection('homeFeatured'),
  getHomeSection('homeCapabilities'),
  getHomeSection('homeTools'),
  getHomeSection('homeProcess'),
  getHomeSection('homeClosing'),
]);
const [about, resume] = await Promise.all([getPage('about'), getPage('resume')]);

const { Content: IntroText } = await render(intro);
const { Content: FeaturedText } = await render(featured);
const { Content: CapabilitiesText } = await render(capabilities);
const { Content: ToolsText } = await render(tools);
const { Content: ProcessText } = await render(process);
const { Content: ClosingText } = await render(closing);

const samples = await getWorkSamples();
const featuredSamples = await getFeaturedSamples(featured.data.samples);
const categories = (await getCategories()).filter((c) =>
  samples.some((s) => s.data.category === c.name),
);

const [firstName, ...otherNames] = settings.name.split(' ');
const resumeHref = resume.data.pdf ? url(resume.data.pdf) : url('/resume/');
const resumeFileName = `${settings.name} - Resume.pdf`;
const linkedinHandle = settings.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const number = (index: number) => String(index + 1).padStart(2, '0');

// Capability boxes and tool tiles take turns using these soft colors
// (defined as --tint-* in src/styles/global.css).
const tints = ['sage', 'blue', 'blush', 'terracotta', 'lavender'];
const capabilityItems = capabilities.data.items
  .filter((item) => !item.hidden)
  .map((item, index) => ({ ...item, tint: tints[index % tints.length] }));
let tileCount = 0;
const toolGroups = tools.data.groups
  .map((group) => ({
    name: group.name,
    items: group.items
      .filter((tool) => !tool.hidden)
      .map((tool) => ({ ...tool, tint: tints[tileCount++ % tints.length] })),
  }))
  .filter((group) => group.items.length > 0);
---

<BaseLayout description={intro.data.description} backLink={false}>
  {
    about.data.headshot && (
      <PhotoCover
        src={about.data.headshot}
        alt={about.data.headshotAlt ?? settings.name}
        labelledby="hero-name"
      >
        <p class="label">{intro.data.tagline}</p>
        <h1 id="hero-name" class="hero-name">
          <span class="word">{firstName}</span>
          {otherNames.length > 0 && <span class="word">{otherNames.join(' ')}</span>}
        </h1>
        <p class="hero-role">{settings.role}</p>
        <div class="hero-intro">
          <IntroText />
        </div>
        <div class="button-row">
          <a class="button button-primary" href={url('/work/')}>
            {intro.data.primaryButton}
          </a>
          <a
            class="button button-secondary"
            href={resumeHref}
            download={resume.data.pdf ? resumeFileName : undefined}
            target={resume.data.pdf ? '_blank' : undefined}
            rel={resume.data.pdf ? 'noopener' : undefined}
          >
            <Icon name="download" />
            {intro.data.secondaryButton}
          </a>
        </div>
      </PhotoCover>
    )
  }

  <CategoryBand categories={categories} label="What I write" />

  <section class="container stats-section" aria-label="At a glance">
    <dl class="stats">
      {
        stats.data.stats.map((stat) => (
          <div class="stat">
            <dt>{stat.label}</dt>
            <dd>
              <span class="stat-value">{stat.value}</span>
              {stat.placeholder && <span class="placeholder-tag">Placeholder</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    featuredSamples.length > 0 && (
      <section class="band featured" aria-labelledby="featured-heading" data-reveal>
        <div class="container">
          <div class="section-heading">
            <div>
              <h2 id="featured-heading">{featured.data.title}</h2>
              {featured.body?.trim() && (
                <div class="intro">
                  <FeaturedText />
                </div>
              )}
            </div>
            <a class="label-link" href={url('/work/')}>
              {featured.data.linkLabel}
              <Icon name="arrow" />
            </a>
          </div>
          <div class="featured-grid">
            {featuredSamples.map((sample) => (
              <WorkCard sample={sample} showSummary={false} moreLink="category" />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="band band-greige" aria-labelledby="capabilities-heading" data-reveal>
    <div class="container">
      <div class="section-heading">
        <div>
          <h2 id="capabilities-heading">{capabilities.data.title}</h2>
          <div class="intro">
            <CapabilitiesText />
          </div>
        </div>
      </div>
      <ul class="capabilities">
        {
          capabilityItems.map((item) => (
            <li class="capability" data-tint={item.tint}>
              <Icon name={item.icon} size={26} class="capability-icon" />
              <h3>{item.name}</h3>
              <p>{item.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="tools-heading" data-reveal>
    <div class="container">
      <div class="section-heading">
        <div>
          <h2 id="tools-heading">{tools.data.title}</h2>
          <div class="intro">
            <ToolsText />
          </div>
        </div>
      </div>
      <div class="tool-groups">
        {
          toolGroups.map((group, index) => (
            <section class="tool-group" aria-labelledby={`tools-${index}`}>
              <div class="tool-group-head">
                <span class="label tool-number" aria-hidden="true">
                  {number(index)}
                </span>
                <h3 id={`tools-${index}`}>{group.name}</h3>
                <span class="tool-count">
                  {group.items.length} {group.items.length === 1 ? 'tool' : 'tools'}
                </span>
              </div>
              <ul class="tool-tiles">
                {group.items.map((tool) => (
                  <li>
                    <span class="tile" data-tint={tool.tint} aria-hidden="true">
                      <Icon name={tool.icon} size={24} />
                    </span>
                    <span class="tool-name">{tool.name}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band band-soft" aria-labelledby="process-heading" data-reveal>
    <div class="container">
      <div class="section-heading">
        <div>
          <h2 id="process-heading">{process.data.title}</h2>
          <div class="intro">
            <ProcessText />
          </div>
        </div>
      </div>
      <ol class="process">
        {
          process.data.steps.map((step, index) => (
            <li>
              <span class="step-number" aria-hidden="true">
                {number(index)}
              </span>
              <h3>{step.name}</h3>
              <p>{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band band-inverse closing" aria-labelledby="closing-heading" data-reveal>
    <div class="container">
      <h2 id="closing-heading">
        <Accent text={closing.data.title} />
      </h2>
      <div class="closing-grid">
        <div class="lead">
          <ClosingText />
        </div>
        <div class="closing-actions">
          <div class="button-row">
            <a class="button button-primary" href={`mailto:${settings.email}`}>
              <Icon name="mail" />
              {closing.data.emailButton}
            </a>
            <a
              class="button button-secondary"
              href={settings.linkedin}
              target="_blank"
              rel="me noopener"
            >
              <Icon name="linkedin" />
              {closing.data.linkedinButton}
            </a>
          </div>
          <p class="label contact-values">
            <span>{settings.email}</span>
            <span>{linkedinHandle}</span>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */

  .hero-name {
    margin-top: 1.25rem;
  }

  .hero-name .word {
    display: block;
    animation: rise 1.2s var(--ease-out) both;
  }

  .hero-name .word + .word {
    animation-delay: 0.12s;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.25em);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-role {
    margin-top: 1.25rem;
    font-family: var(--font-heading);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .hero-intro {
    margin-top: 1.25rem;
    max-width: 46ch;
    color: var(--text-muted);
  }

  .button-row {
    margin-top: 1.75rem;
  }

  /* ---------- Stats ---------- */

  .stats-section {
    padding-block: clamp(2rem, 5vw, 3rem);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.4rem;
    padding: 1.25rem clamp(0.75rem, 2vw, 1.5rem);
  }

  .stat + .stat {
    border-left: 1px solid var(--border);
  }

  .stat dt {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .stat dd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    margin: 0;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1;
  }

  /* ---------- Featured work ---------- */

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* ---------- Capabilities ---------- */

  .capabilities {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .capability {
    padding: clamp(1rem, 2.5vw, 1.75rem);
    background: var(--tint);
    border-top: 1px solid var(--border-strong);
  }

  .capability :global(.capability-icon) {
    color: var(--tint-ink);
    stroke-width: 1.4;
  }

  .capability h3 {
    margin-top: 1rem;
  }

  .capability p {
    margin-top: 0.5rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  /* ---------- Tools ---------- */

  .tool-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .tool-group-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-strong);
  }

  .tool-count {
    color: var(--text-muted);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .tool-tiles {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem 0.75rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tool-tiles li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
  }

  .tile {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    background: var(--tint);
    border: 1px solid transparent;
    color: var(--tint-ink);
    transition: border-color 0.25s var(--ease);
  }

  .tool-tiles li:hover .tile {
    border-color: var(--tint-ink);
  }

  .tile :global(.icon) {
    stroke-width: 1.3;
  }

  .tool-name {
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  /* ---------- Process ---------- */

  .process {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process li {
    padding-top: 1rem;
    border-top: 1px solid var(--border-strong);
  }

  .step-number {
    display: block;
    color: var(--accent-text);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 300;
    line-height: 1;
  }

  .process h3 {
    margin-top: 0.75rem;
  }

  .process p {
    margin-top: 0.4rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  /* ---------- Closing band ---------- */

  .closing-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: end;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .closing .lead {
    max-width: 44ch;
  }

  .closing-actions {
    justify-self: end;
  }

  .contact-values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: 1.25rem;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    text-transform: none;
  }

  /* ---------- Smaller screens ---------- */

  @media (max-width: 1024px) {
    .tool-groups {
      grid-template-columns: minmax(0, 1fr);
    }

    .process {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .closing-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .closing-actions {
      justify-self: start;
    }
  }

  @media (max-width: 760px) {
    .capabilities {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tool-tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .process {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stat + .stat {
      border-left: 0;
    }

    .stat:nth-child(even) {
      border-left: 1px solid var(--border);
    }

    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }

    /* Featured cards scroll sideways instead of stacking into a long column. */
    .featured-grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 78%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.75rem;
      scrollbar-width: thin;
    }

    .featured-grid > :global(*) {
      scroll-snap-align: start;
    }
  }
</style>
