---
/*
 * Home page. Every word on this page comes from a Markdown file:
 *   content/settings.md              your name, job title, email, and LinkedIn
 *   content/home/intro.md            hero details, button labels, and the introduction
 *   content/home/stats.md            the two stats
 *   content/home/featured.md         featured work heading (cards come from content/work/)
 *   content/home/capabilities.md     core capabilities
 *   content/home/tools.md            tools & technologies
 *   content/home/process.md          my process
 *   content/home/closing.md          the "Let's work together" band
 *   content/pages/about.md           your photo
 *   content/pages/work.md            the categories in the black band
 */
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Accent from '../components/Accent.astro';
import CategoryBand from '../components/CategoryBand.astro';
import Cutout from '../components/Cutout.astro';
import Icon from '../components/Icon.astro';
import WorkCard from '../components/WorkCard.astro';
import {
  getCategories,
  getHomeSection,
  getPage,
  getSettings,
  getWorkSamples,
  url,
} from '../lib/content';

const settings = await getSettings();
const [intro, stats, featured, capabilities, tools, process, closing] = await Promise.all([
  getHomeSection('homeIntro'),
  getHomeSection('homeStats'),
  getHomeSection('homeFeatured'),
  getHomeSection('homeCapabilities'),
  getHomeSection('homeTools'),
  getHomeSection('homeProcess'),
  getHomeSection('homeClosing'),
]);
const [about, resume] = await Promise.all([getPage('about'), getPage('resume')]);

const { Content: IntroText } = await render(intro);
const { Content: FeaturedText } = await render(featured);
const { Content: CapabilitiesText } = await render(capabilities);
const { Content: ToolsText } = await render(tools);
const { Content: ProcessText } = await render(process);
const { Content: ClosingText } = await render(closing);

const samples = await getWorkSamples();
const featuredSamples = samples.filter((s) => s.data.featured).slice(0, 3);
const categories = (await getCategories()).filter((c) =>
  samples.some((s) => s.data.category === c.name),
);

const [firstName, ...otherNames] = settings.name.split(' ');
const resumeHref = resume.data.pdf ? url(resume.data.pdf) : url('/resume/');
const resumeFileName = `${settings.name} - Resume.pdf`;
const linkedinHandle = settings.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<BaseLayout description={intro.data.description}>
  <section class="cover" aria-labelledby="cover-name">
    <h1 id="cover-name" class="masthead">
      <span class="mast-line mast-name">
        <span class="word">{firstName}</span>
        {otherNames.length > 0 && <span class="word">{otherNames.join(' ')}</span>}
      </span>
      <span class="visually-hidden">, </span>
      <span class="mast-line mast-role">{settings.role}</span>
    </h1>

    {
      about.data.headshot && (
        <div class="cover-photo">
          <Cutout
            src={about.data.headshot}
            alt={about.data.headshotAlt ?? settings.name}
            sizes="(max-width: 760px) 84vw, 36vw"
            eager
          />
        </div>
      )
    }

    <p class="label cover-detail cover-tagline">{intro.data.tagline}</p>
    <p class="label cover-detail cover-edition">{intro.data.edition}</p>

    <div class="cover-actions button-row">
      <a class="button button-primary" href={url('/work/')}>{intro.data.primaryButton}</a>
      <a
        class="button button-secondary"
        href={resumeHref}
        download={resume.data.pdf ? resumeFileName : undefined}
      >
        <Icon name="download" />
        {intro.data.secondaryButton}
      </a>
    </div>
  </section>

  <CategoryBand categories={categories} label="What I write" />

  <section class="band container statement" aria-label="Introduction" data-reveal>
    <div class="statement-text">
      <p class="label">Introduction</p>
      <div class="statement-body">
        <IntroText />
      </div>
    </div>
    <dl class="stats">
      {
        stats.data.stats.map((stat) => (
          <div class="stat">
            <dt class="label">{stat.label}</dt>
            <dd>
              <span class="stat-value">{stat.value}</span>
              {stat.placeholder && <span class="placeholder-tag">Placeholder</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    featuredSamples.length > 0 && (
      <section class="band featured" aria-labelledby="featured-heading" data-reveal>
        <div class="container">
          <div class="section-heading">
            <div>
              <h2 id="featured-heading">{featured.data.title}</h2>
              <div class="intro">
                <FeaturedText />
              </div>
            </div>
            <a class="label-link" href={url('/work/')}>
              {featured.data.linkLabel}
              <Icon name="arrow" />
            </a>
          </div>
          <div class="featured-grid">
            {featuredSamples.map((sample) => (
              <WorkCard sample={sample} showSummary={false} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="band band-greige" aria-labelledby="capabilities-heading" data-reveal>
    <div class="container">
      <div class="section-heading">
        <div>
          <h2 id="capabilities-heading">{capabilities.data.title}</h2>
          <div class="intro">
            <CapabilitiesText />
          </div>
        </div>
      </div>
      <ul class="capabilities">
        {
          capabilities.data.items.map((item) => (
            <li class="capability">
              <Icon name={item.icon} size={30} class="capability-icon" />
              <h3>{item.name}</h3>
              <p>{item.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="tools-heading" data-reveal>
    <div class="container tools-layout">
      <div class="section-heading">
        <div>
          <h2 id="tools-heading">{tools.data.title}</h2>
          <div class="intro">
            <ToolsText />
          </div>
        </div>
      </div>
      <ul class="tools">
        {
          tools.data.items.map((tool) => (
            <li>
              <Icon name={tool.icon} size={22} />
              {tool.name}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band band-soft" aria-labelledby="process-heading" data-reveal>
    <div class="container">
      <div class="section-heading">
        <div>
          <h2 id="process-heading">{process.data.title}</h2>
          <div class="intro">
            <ProcessText />
          </div>
        </div>
      </div>
      <ol class="process">
        {
          process.data.steps.map((step, index) => (
            <li>
              <span class="step-number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{step.name}</h3>
              <p>{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band band-inverse closing" aria-labelledby="closing-heading" data-reveal>
    <div class="container">
      <h2 id="closing-heading" class="closing-title">
        <Accent text={closing.data.title} />
      </h2>
      <div class="closing-grid">
        <div class="lead">
          <ClosingText />
        </div>
        <div class="closing-actions">
          <div class="button-row">
            <a class="button button-primary" href={`mailto:${settings.email}`}>
              <Icon name="mail" />
              {closing.data.emailButton}
            </a>
            <a
              class="button button-secondary"
              href={settings.linkedin}
              target="_blank"
              rel="me noopener"
            >
              <Icon name="linkedin" />
              {closing.data.linkedinButton}
            </a>
          </div>
          <p class="label contact-values">
            <span>{settings.email}</span>
            <span>{linkedinHandle}</span>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Cover (hero) ---------- */

  .cover {
    /* The giant type is sized from the page width so both lines span it exactly. */
    --mast: min(10.05vw, 12.5rem);
    --mast-top: clamp(2.5rem, 5vw, 4.5rem);
    --photo-w: min(34vw, 580px);
    --photo-h: calc(var(--photo-w) * 1.18);
    --side: calc((100% - var(--photo-w)) / 2 - var(--gutter) - 0.5rem);

    position: relative;
    /* The top of the photo overlaps the lower half of the title line. */
    height: calc(var(--mast-top) + var(--mast) * 1.32 + var(--photo-h));
    min-height: 560px;
    overflow: hidden;
    isolation: isolate;
    background: var(--bg-soft);
  }

  .masthead {
    position: absolute;
    top: var(--mast-top);
    left: 0;
    right: 0;
    z-index: 1;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--mast);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.86;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .mast-line {
    display: block;
    animation: mast-in 1.6s var(--ease-out) both;
  }

  .mast-name {
    font-stretch: 100%;
  }

  .mast-role {
    font-stretch: 83%;
    animation-delay: 0.18s;
  }

  .mast-name .word + .word::before {
    content: ' ';
  }

  /* The giant name and title rise gently into place behind the photo. */
  @keyframes mast-in {
    from {
      opacity: 0;
      transform: translateY(0.35em);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  .cover-photo {
    position: absolute;
    bottom: 0;
    left: 50%;
    z-index: 2;
    width: var(--photo-w);
    transform: translateX(-50%);
  }

  .cover-detail {
    position: absolute;
    z-index: 3;
    top: calc(var(--mast-top) + var(--mast) * 1.9);
    max-width: var(--side);
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--ink);
  }

  /* A short taupe rule beside each detail. */
  .cover-detail::before {
    content: '';
    flex: none;
    width: 2rem;
    height: 1px;
    background: var(--accent);
  }

  .cover-tagline {
    left: var(--gutter);
  }

  .cover-edition {
    right: var(--gutter);
    flex-direction: row-reverse;
  }

  .cover-actions {
    position: absolute;
    z-index: 3;
    left: var(--gutter);
    bottom: clamp(1.75rem, 4vw, 3rem);
    flex-direction: column;
    align-items: stretch;
    width: max-content;
    max-width: var(--side);
  }

  /* ---------- Introduction and stats ---------- */

  .statement {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: end;
  }

  .statement-body {
    margin-top: 1.5rem;
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    font-weight: 450;
    /* A smaller optical size gives the serif sturdier hairlines for reading. */
    font-variation-settings: 'opsz' 24;
    line-height: 1.28;
    letter-spacing: -0.005em;
  }

  .stats {
    display: grid;
    margin: 0;
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border-strong);
  }

  .stat dt {
    color: var(--text-muted);
  }

  .stat dd {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 7vw, 5.5rem);
    font-weight: 800;
    line-height: 1;
  }

  /* ---------- Featured work ---------- */

  .featured {
    border-top: 1px solid var(--border);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(2rem, 3vw, 2.75rem);
  }

  /* ---------- Capabilities ---------- */

  .capabilities {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 0 clamp(2rem, 4vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .capability {
    padding-block: 2rem 2.5rem;
    border-top: 1px solid var(--border-strong);
  }

  .capability :global(.capability-icon) {
    color: var(--ink);
    stroke-width: 1.25;
  }

  .capability h3 {
    margin-top: 1.5rem;
    font-size: clamp(1.5rem, 2.2vw, 1.75rem);
  }

  .capability p {
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-size: 0.96875rem;
    line-height: 1.65;
  }

  /* ---------- Tools ---------- */

  .tools-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr);
    gap: clamp(1.5rem, 6vw, 6rem);
    align-items: start;
  }

  .tools-layout .section-heading {
    margin-bottom: 0;
  }

  .tools {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(46%, 220px), 1fr));
    gap: 0 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border-strong);
  }

  .tools li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 64px;
    border-bottom: 1px solid var(--border);
    font-size: 0.96875rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .tools :global(.icon) {
    flex: none;
    color: var(--accent-text);
    stroke-width: 1.35;
  }

  /* ---------- Process ---------- */

  .process {
    --step-gap: clamp(1.25rem, 2.5vw, 2.5rem);
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--step-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process li {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-strong);
  }

  .step-number {
    display: block;
    color: var(--accent-text);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 300;
    line-height: 1;
  }

  .process h3 {
    margin-top: 1.25rem;
    font-size: 1.625rem;
  }

  .process p {
    margin-top: 0.6rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* ---------- Closing band ---------- */

  .closing-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 9.5vw, 8.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .closing-title :global(.script) {
    display: inline-block;
    margin-left: 0.05em;
    color: var(--accent-large);
    font-size: 1.15em;
    line-height: 0.5;
    transform: rotate(-4deg) translateY(0.08em);
  }

  .closing-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .closing .lead {
    max-width: 44ch;
  }

  .closing-actions {
    justify-self: end;
  }

  .contact-values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: 1.5rem;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    text-transform: none;
  }

  /* ---------- Smaller screens ---------- */

  @media (max-width: 1100px) {
    .process {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    }
  }

  @media (max-width: 860px) {
    .statement,
    .tools-layout,
    .closing-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .closing-actions {
      justify-self: start;
    }
  }

  /* Tablets: the details sit in a row above the masthead and the buttons below the photo. */
  @media (max-width: 1024px) {
    .cover {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'tagline edition'
        'masthead masthead'
        'photo photo'
        'actions actions';
      height: auto;
      min-height: 0;
      padding-top: 1.75rem;
    }

    .cover-detail {
      position: static;
      max-width: none;
    }

    .cover-tagline {
      grid-area: tagline;
      margin-left: var(--gutter);
    }

    .cover-edition {
      grid-area: edition;
      margin-right: var(--gutter);
    }

    .masthead {
      grid-area: masthead;
      position: relative;
      top: 0;
      margin-top: 1.75rem;
    }

    .cover-photo {
      grid-area: photo;
      position: relative;
      left: auto;
      justify-self: center;
      width: min(58vw, 480px);
      margin-top: calc(var(--mast) * -0.36);
      transform: none;
    }

    .cover-actions {
      grid-area: actions;
      position: static;
      flex-direction: row;
      justify-content: center;
      width: auto;
      max-width: none;
      padding: 1.5rem var(--gutter);
      background: var(--bg);
    }
  }

  /* Phones: the name stacks on two lines and the title condenses to fit. */
  @media (max-width: 760px) {
    .cover {
      --name-size: 20vw;
      --role-size: 12.6vw;
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'tagline'
        'edition'
        'masthead'
        'photo'
        'actions';
    }

    .cover-edition {
      flex-direction: row;
      margin-top: 0.6rem;
      margin-left: var(--gutter);
    }

    .masthead {
      margin-top: 1.5rem;
    }

    .mast-name {
      font-size: var(--name-size);
      line-height: 0.84;
    }

    .mast-name .word {
      display: block;
    }

    .mast-name .word + .word::before {
      content: none;
    }

    .mast-role {
      margin-top: 0.1em;
      font-size: var(--role-size);
      font-stretch: 62%;
    }

    .cover-photo {
      width: min(84vw, 480px);
      margin-top: calc(var(--role-size) * -0.3);
    }

    .cover-actions {
      flex-direction: column;
    }

    .stat-value {
      font-size: 3.5rem;
    }
  }
</style>
