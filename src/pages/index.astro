---
/*
 * Home page. The words on this page come from content/pages/home.md and
 * content/settings.md. Featured samples are the work samples marked
 * `featured: true` in content/work/.
 */
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import {
  categoryHref,
  getCategories,
  getPage,
  getSettings,
  getWorkSamples,
  url,
} from '../lib/content';

const settings = await getSettings();
const page = await getPage('home');
const { Content } = await render(page);
const samples = await getWorkSamples();
const featured = samples.filter((sample) => sample.data.featured);
const categories = (await getCategories()).filter((category) =>
  samples.some((sample) => sample.data.category === category.name),
);
---

<BaseLayout description={page.data.description}>
  <section class="hero container">
    <h1>{settings.name}</h1>
    {page.data.headline && <p class="headline">{page.data.headline}</p>}
    <div class="intro prose">
      <Content />
    </div>
    <div class="button-row">
      <a class="button button-primary" href={url('/work/')}>View work samples</a>
      <a class="button button-secondary" href={url('/resume/')}>Résumé</a>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="section container" aria-labelledby="featured-heading">
        <div class="section-heading">
          <div>
            <h2 id="featured-heading">Featured work</h2>
            <p>A few samples that show how I approach a documentation problem.</p>
          </div>
          <a class="text-link" href={url('/work/')}>
            All work samples <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="card-grid">
          {featured.map((sample) => (
            <WorkCard sample={sample} />
          ))}
        </div>
      </section>
    )
  }

  <section class="section container" aria-labelledby="focus-heading">
    <div class="section-heading">
      <div>
        <h2 id="focus-heading">What I write</h2>
      </div>
    </div>
    <ul class="focus-list">
      {
        categories.map((category) => (
          <li>
            <a href={categoryHref(category.name)}>
              <span class="focus-name">{category.name}</span>
              <span class="focus-description">{category.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(4rem, 12vw, 8rem) clamp(3rem, 8vw, 5rem);
  }

  .hero h1 {
    font-size: clamp(2.75rem, 8vw, 4.75rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .headline {
    margin-top: 1.25rem;
    color: var(--accent);
    font-size: clamp(1.125rem, 2.4vw, 1.375rem);
    font-weight: 550;
    letter-spacing: -0.01em;
  }

  .intro {
    margin-top: 1.5rem;
    max-width: 62ch;
    color: var(--text-muted);
    font-size: clamp(1.0625rem, 2vw, 1.1875rem);
  }

  .button-row {
    margin-top: 2.25rem;
  }

  .focus-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .focus-list a {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .focus-list a:hover {
    border-color: var(--border-strong);
    background: var(--bg-subtle);
  }

  .focus-name {
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .focus-name::after {
    content: ' →';
    color: var(--accent);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .focus-list a:hover .focus-name::after {
    opacity: 1;
  }

  .focus-description {
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
</style>
