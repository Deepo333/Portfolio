---
/*
 * Home page. Every word on this page comes from a Markdown file:
 *   content/settings.md              your name, job title, email, and LinkedIn
 *   content/home/intro.md            hero tagline, intro, and button label
 *   content/home/banner.md           the document types in the scrolling black band
 *   content/home/stats.md            the four stats
 *   content/home/featured.md         featured work heading and its three category cards
 *   content/home/capabilities.md     core capabilities
 *   content/home/tools.md            tools & technologies, in groups
 *   content/home/process.md          my process
 *   content/home/closing.md          the "Let's work together" band
 *   content/pages/about.md           your photo
 */
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Accent from '../components/Accent.astro';
import Letters from '../components/Letters.astro';
import Marquee from '../components/Marquee.astro';
import Icon from '../components/Icon.astro';
import PhotoCover from '../components/PhotoCover.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import { getFeaturedSamples, getHomeSection, getPage, getSettings, url } from '../lib/content';
import { getLogos } from '../lib/logos';

const settings = await getSettings();
const [intro, banner, stats, featured, capabilities, tools, process, closing] = await Promise.all([
  getHomeSection('homeIntro'),
  getHomeSection('homeBanner'),
  getHomeSection('homeStats'),
  getHomeSection('homeFeatured'),
  getHomeSection('homeCapabilities'),
  getHomeSection('homeTools'),
  getHomeSection('homeProcess'),
  getHomeSection('homeClosing'),
]);
const [about, resume] = await Promise.all([getPage('about'), getPage('resume')]);

const { Content: IntroText } = await render(intro);
const { Content: FeaturedText } = await render(featured);
const { Content: CapabilitiesText } = await render(capabilities);
const { Content: ToolsText } = await render(tools);
const { Content: ProcessText } = await render(process);
const { Content: ClosingText } = await render(closing);

const featuredSamples = await getFeaturedSamples(featured.data.cards.map((card) => card.sample));

// Your name, split into letters for the typewriter effect. A one-letter pause
// at the line break keeps the rhythm natural.
let typeIndex = 0;
const nameWords = settings.name.split(' ').map((word, w) => {
  if (w > 0) typeIndex++;
  return [...word].map((letter) => ({ letter, i: typeIndex++ }));
});
const lastTyped = typeIndex - 1;
const resumeHref = resume.data.pdf ? url(resume.data.pdf) : url('/resume/');
const resumeFileName = `${settings.name} - Resume.pdf`;
const linkedinHandle = settings.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const number = (index: number) => String(index + 1).padStart(2, '0');

// Capability cards take turns using these deep colors
// (defined as --tint-* in src/styles/global.css).
const tints = ['navy', 'olive', 'brown', 'mustard'];
const capabilityItems = capabilities.data.items
  .filter((item) => !item.hidden)
  .map((item, index) => ({ ...item, tint: tints[index % tints.length] }));
// Tool tiles show each tool's real logo (from Simple Icons), or its name if no logo exists.
const groupTints = ['navy', 'olive', 'brown', 'mustard'];
const toolGroups = tools.data.groups
  .filter((group) => group.items.some((tool) => !tool.hidden))
  .map((group, index) => ({
    name: group.name,
    tint: groupTints[index % groupTints.length],
    items: group.items
      .filter((tool) => !tool.hidden)
      .map((tool) => ({
        name: tool.name,
        logos: getLogos(tool.logo, tool.name),
        file: tool.logoFile,
        plate: tool.logoPlate,
      })),
  }))
  .filter((group) => group.items.length > 0);
---

<BaseLayout description={intro.data.description} backLink={false}>
  {
    about.data.headshot && (
      <PhotoCover
        src={about.data.headshot}
        alt={about.data.headshotAlt ?? settings.name}
        labelledby="hero-name"
      >
        <div class="hero-anim" data-replay style={`--type-count: ${lastTyped + 1}`}>
          <p class="hero-tagline hero-line">{intro.data.tagline}</p>
          <h1 id="hero-name" class="hero-name page-title">
            <span class="visually-hidden">{settings.name}</span>
            <span aria-hidden="true">
              {nameWords.map((word, w) => (
                <span class="word">
                  {word.map(({ letter, i }) => (
                    <span
                      class:list={[
                        'ch',
                        { 'ch-last': i === lastTyped },
                        { 'ch-pause': w < nameWords.length - 1 && i === word[word.length - 1].i },
                      ]}
                      style={`--i: ${i}`}
                    >
                      {letter}
                    </span>
                  ))}
                </span>
              ))}
            </span>
          </h1>
          <p class="hero-role hero-line">{settings.role}</p>
          <div class="hero-intro">
            <IntroText />
          </div>
        </div>
        <div class="button-row">
          {intro.data.primaryButton && (
            <a class="button button-secondary" href={url('/work/')}>
              {intro.data.primaryButton}
            </a>
          )}
          <a
            class="button button-primary"
            href={resumeHref}
            download={resume.data.pdf ? resumeFileName : undefined}
            target={resume.data.pdf ? '_blank' : undefined}
            rel={resume.data.pdf ? 'noopener' : undefined}
          >
            <Icon name="download" />
            {intro.data.secondaryButton}
          </a>
        </div>
      </PhotoCover>
    )
  }

  <Marquee items={banner.data.items} />

  <section class="container stats-section" aria-label="At a glance">
    <dl class="stats">
      {
        stats.data.stats.map((stat, index) => (
          <div class="stat" data-reveal="fade" style={`--reveal-delay: ${index * 0.12}s`}>
            <dt>{stat.label}</dt>
            <dd>
              <span class="stat-value">{stat.value}</span>
              {stat.placeholder && <span class="placeholder-tag">Placeholder</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    featuredSamples.length > 0 && (
      <section class="band featured" aria-labelledby="featured-heading">
        <div class="container">
          <div class="section-heading" data-reveal>
            <div>
              <h2 id="featured-heading" class="section-title">{featured.data.title}</h2>
              {featured.body?.trim() && (
                <div class="intro">
                  <FeaturedText />
                </div>
              )}
            </div>
            <a class="label-link" href={url('/work/')}>
              {featured.data.linkLabel}
              <Icon name="arrow" />
            </a>
          </div>
          <div class="featured-grid">
            {featuredSamples.map((sample, index) => (
              <FeaturedCard
                sample={sample}
                description={featured.data.cards[index].description}
                revealDelay={index * 0.12}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="band band-greige" aria-labelledby="capabilities-heading">
    <div class="container">
      <div class="section-heading" data-reveal="fade">
        <div>
          <h2 id="capabilities-heading" class="section-title">{capabilities.data.title}</h2>
          <div class="intro">
            <CapabilitiesText />
          </div>
        </div>
      </div>
      <ul class="capabilities">
        {
          capabilityItems.map((item, index) => (
            <li
              class="capability"
              data-tint={item.tint}
              data-reveal
              style={`--reveal-delay: ${(index % 3) * 0.08}s`}
            >
              <Icon name={item.icon} size={26} class="capability-icon" />
              <h3>{item.name}</h3>
              <p>{item.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="tools-heading">
    <div class="container">
      <div class="section-heading" data-reveal="fade">
        <div>
          <h2 id="tools-heading" class="section-title">{tools.data.title}</h2>
          <div class="intro">
            <ToolsText />
          </div>
        </div>
      </div>
      <div class="tool-groups">
        {
          toolGroups.map((group, index) => (
            <section
              class="tool-group"
              aria-labelledby={`tools-${index}`}
              data-reveal
              style={`--reveal-delay: ${(index % 2) * 0.08}s`}
            >
              <div class="tool-group-head">
                <span class="label tool-number" aria-hidden="true">
                  {number(index)}
                </span>
                <h3 id={`tools-${index}`}>{group.name}</h3>
                <span class="tool-count">
                  {group.items.length} {group.items.length === 1 ? 'tool' : 'tools'}
                </span>
              </div>
              <ul class="tool-tiles" data-tint={group.tint}>
                {group.items.map((tool) => (
                  <li>
                    <span
                      class:list={[
                        'tile',
                        { 'text-tile': tool.logos.length === 0 && !tool.file },
                        { 'dark-plate': tool.plate === 'dark' },
                      ]}
                      aria-hidden="true"
                    >
                      {tool.logos.length > 0 ? (
                        tool.logos.map((logo) => (
                          <svg class="logo" viewBox="0 0 24 24" fill={`#${logo.hex}`}>
                            <path d={logo.path} />
                          </svg>
                        ))
                      ) : tool.file ? (
                        <img class="logo-file" src={url(tool.file)} alt="" loading="lazy" />
                      ) : (
                        tool.name
                      )}
                    </span>
                    <span class:list={[tool.logos.length > 0 || tool.file ? 'tool-name' : 'visually-hidden']}>
                      {tool.name}
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band band-soft" aria-labelledby="process-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2 id="process-heading" class="section-title" data-reveal="letters">
            <Letters text={process.data.title} />
          </h2>
          <div class="intro">
            <ProcessText />
          </div>
        </div>
      </div>
      <ol class="process">
        {
          process.data.steps.map((step, index) => (
            <li data-reveal style={`--reveal-delay: ${index * 0.06}s`}>
              <span class="step-number" aria-hidden="true">
                {number(index)}
              </span>
              <h3>{step.name}</h3>
              <p>{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band band-inverse closing" aria-labelledby="closing-heading">
    <div class="container">
      <h2 id="closing-heading" class="section-title" data-reveal>
        <Accent text={closing.data.title} />
      </h2>
      <div class="closing-grid" data-reveal>
        <div class="lead">
          <ClosingText />
        </div>
        <div class="closing-actions">
          <div class="button-row">
            <a class="button button-primary" href={`mailto:${settings.email}`}>
              <Icon name="mail" />
              {closing.data.emailButton}
            </a>
            <a
              class="button button-secondary"
              href={settings.linkedin}
              target="_blank"
              rel="me noopener"
            >
              <Icon name="linkedin" />
              {closing.data.linkedinButton}
            </a>
          </div>
          <p class="label contact-values">
            <span>{settings.email}</span>
            <span>{linkedinHandle}</span>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */

  .hero-name {
    margin-top: 1rem;
  }

  .hero-name .word {
    display: block;
  }

  /* ---------- Hero animation ----------
     Plays on load, and again whenever the hero scrolls back into view
     (src/layouts/BaseLayout.astro adds and removes .is-reset).
       1. The line above your name drops in from the top.
       2. Your name types out letter by letter, with a blinking cursor that
          blinks a few times at the end, then fades away.
       3. Your title slides in from the left once the name is typed.
       4. The intro rises up from below.
     The Download résumé button doesn't move. */
  .hero-anim {
    --type-start: 0.35s;
    --type-step: 0.11s;
    --type-end: calc(var(--type-start) + var(--type-count) * var(--type-step));
  }

  .ch {
    position: relative;
  }

  /* The text cursor: a thin bar just after the letter being typed. */
  .ch::after {
    content: '';
    position: absolute;
    top: 0.1em;
    bottom: 0.06em;
    left: 100%;
    width: 0.06em;
    margin-left: 0.05em;
    background: currentColor;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-anim:not(.is-reset) .hero-tagline {
      animation: drop-in 1s var(--ease-soft) both;
    }

    .hero-anim:not(.is-reset) .ch {
      animation: type-in 0.06s linear both;
      animation-delay: calc(var(--type-start) + var(--i) * var(--type-step));
    }

    .hero-anim:not(.is-reset) .ch::after {
      animation: caret-pass var(--type-step) linear;
      animation-delay: calc(var(--type-start) + var(--i) * var(--type-step));
    }

    /* At the line break, the cursor waits one extra beat before moving on. */
    .hero-anim:not(.is-reset) .ch-pause::after {
      animation-duration: calc(var(--type-step) * 2);
    }

    .hero-anim:not(.is-reset) .ch-last::after {
      animation: caret-end 2.4s linear forwards;
      animation-delay: calc(var(--type-start) + var(--i) * var(--type-step));
    }

    .hero-anim:not(.is-reset) .hero-role {
      animation: slide-in-left 1s var(--ease-soft) both;
      animation-delay: var(--type-end);
    }

    .hero-anim:not(.is-reset) .hero-intro {
      animation: rise-in 1s var(--ease-soft) both;
      animation-delay: calc(var(--type-end) + 0.3s);
    }
  }

  @keyframes drop-in {
    from {
      opacity: 0;
      transform: translateY(-24px);
    }
  }

  @keyframes type-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes caret-pass {
    0%,
    100% {
      opacity: 1;
    }
  }

  /* Three blinks, then a gentle fade. */
  @keyframes caret-end {
    0%,
    16% {
      opacity: 1;
    }

    17%,
    32% {
      opacity: 0;
    }

    33%,
    49% {
      opacity: 1;
    }

    50%,
    65% {
      opacity: 0;
    }

    66%,
    80% {
      opacity: 1;
    }

    100% {
      opacity: 0;
    }
  }

  @keyframes slide-in-left {
    from {
      opacity: 0;
      transform: translateX(-40px);
    }
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  /* The line above your name and your title share one style (Marcellus). */
  .hero-line {
    color: var(--ink);
    font-family: var(--font-heading);
    font-size: clamp(0.9375rem, 1.5vw, 1.25rem);
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .hero-role {
    margin-top: 1.25rem;
  }

  .hero-intro {
    margin-top: 1.25rem;
    max-width: 46ch;
    color: var(--text-muted);
  }

  .button-row {
    margin-top: 1.75rem;
  }

  /* ---------- Stats ---------- */

  .stats-section {
    padding-block: clamp(2rem, 5vw, 3rem);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.4rem;
    padding: 1.25rem clamp(0.75rem, 2vw, 1.5rem);
  }

  .stat + .stat {
    border-left: 1px solid var(--border);
  }

  .stat dt {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .stat dd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    margin: 0;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1;
  }

  /* ---------- Featured work ---------- */

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* ---------- Capabilities ---------- */

  .capabilities {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .capability {
    /* White text on the deep colors. */
    --text-muted: #ffffff;
    --heading: #ffffff;
    color: #ffffff;
    padding: clamp(1rem, 2.5vw, 1.75rem);
    background: var(--tint);
    border-top: 1px solid var(--border-strong);
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .capability:hover {
      transform: translateY(-4px);
    }

    .tool-tiles li:hover .tile {
      transform: translateY(-3px);
    }
  }

  .capability :global(.capability-icon) {
    color: var(--tint-ink);
    stroke-width: 1.4;
  }

  .capability h3 {
    margin-top: 1rem;
  }

  .capability p {
    margin-top: 0.5rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  /* ---------- Tools ---------- */

  .tool-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .tool-group-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-strong);
  }

  .tool-count {
    color: var(--text-muted);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .tool-tiles {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem 0.75rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tool-tiles li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
  }

  /* A thin outline box around each logo, in the group's color; no fill, so the focus
     stays on the logo. In dark mode the box gets a light backdrop so dark logos show. */
  .tile {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8%;
    width: 100%;
    aspect-ratio: 1;
    padding: 0.75rem;
    background: transparent;
    border: 1.5px solid var(--tint-line);
    color: var(--ink);
    transition:
      border-color 0.25s var(--ease),
      transform 0.3s var(--ease-out);
  }

  :global(:root[data-theme='dark']) .tile {
    background: #f5f4f1;
    color: #2b2826;
  }

  /* Logos with white lettering sit on a dark backdrop. */
  .tile.dark-plate,
  :global(:root[data-theme='dark']) .tile.dark-plate {
    background: #2b2b2b;
  }

  .tool-tiles li:hover .tile {
    border-color: var(--ink);
  }

  .logo {
    width: 52%;
    height: auto;
    flex: none;
  }

  /* Two logos share one box (for example Git and GitHub). */
  .logo:not(:only-child) {
    width: 36%;
  }

  .logo-file {
    width: 82%;
    height: auto;
    max-height: 82%;
    object-fit: contain;
  }

  /* Tools without a logo show their name instead. */
  .text-tile {
    font-size: clamp(0.75rem, 1vw, 0.875rem);
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .tool-name {
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  /* ---------- Process ---------- */

  .process {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process li {
    padding-top: 1rem;
    border-top: 1px solid var(--border-strong);
  }

  .step-number {
    display: block;
    color: var(--accent-text);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 300;
    line-height: 1;
  }

  .process h3 {
    margin-top: 0.75rem;
  }

  .process p {
    margin-top: 0.4rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  /* ---------- Closing band ---------- */

  .closing-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: end;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .closing .lead {
    max-width: 44ch;
  }

  .closing-actions {
    justify-self: end;
  }

  .contact-values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: 1.25rem;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    text-transform: none;
  }

  /* ---------- Smaller screens ---------- */

  @media (max-width: 1024px) {
    .tool-groups {
      grid-template-columns: minmax(0, 1fr);
    }

    .process {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .closing-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .closing-actions {
      justify-self: start;
    }
  }

  @media (max-width: 760px) {
    .capabilities {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tool-tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .process {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stat + .stat {
      border-left: 0;
    }

    .stat:nth-child(even) {
      border-left: 1px solid var(--border);
    }

    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }

    /* Featured cards scroll sideways instead of stacking into a long column. */
    .featured-grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 78%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.75rem;
      scrollbar-width: thin;
    }

    .featured-grid > :global(*) {
      scroll-snap-align: start;
    }
  }
</style>
