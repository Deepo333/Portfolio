---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/content';
---

<BaseLayout title="Page not found">
  <header class="page-header container">
    <p class="eyebrow">404</p>
    <h1>This page doesn’t exist</h1>
    <p class="lead">The link may be out of date, or the address may have a typo.</p>
    <div class="button-row">
      <a class="button button-primary" href={url('/')}>Go to the home page</a>
      <a class="button button-secondary" href={url('/work/')}>Browse work samples</a>
    </div>
  </header>
</BaseLayout>

<style>
  .button-row {
    margin-top: 2rem;
  }
</style>
