---
/* Résumé page. The words and PDF location come from content/pages/resume.md. */
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Letters from '../components/Letters.astro';
import PdfViewer from '../components/PdfViewer.astro';
import { getPage, getSettings, url } from '../lib/content';

const settings = await getSettings();
const page = await getPage('resume');
const { Content } = await render(page);
const { title, description, pdf } = page.data;
const downloadName = `${settings.name} - Resume.pdf`;
---

<BaseLayout title={title} description={description}>
  <header class="page-header container">
    <h1 class="page-title" data-reveal="letters"><Letters text={title} /></h1>
    <div class="lead prose">
      <Content />
    </div>
    {
      pdf && (
        <div class="button-row">
          <a
            class="button button-primary"
            href={url(pdf)}
            download={downloadName}
            target="_blank"
            rel="noopener"
          >
            <Icon name="download" />
            Download PDF
          </a>
        </div>
      )
    }
  </header>

  {
    pdf && (
      <section class="container preview" aria-label="Résumé preview">
        <PdfViewer src={pdf} title={title} downloadName={downloadName} />
      </section>
    )
  }
</BaseLayout>

<style>
  .button-row {
    align-items: center;
    margin-top: 2rem;
    gap: 1rem 1.5rem;
  }

  .preview {
    padding-bottom: var(--section-space);
  }
</style>
