---
import '@fontsource-variable/inter';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource/ms-madi';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSettings, url } from '../lib/content';

interface Props {
  /** Shown in the browser tab, before your name. Leave empty on the home page. */
  title?: string;
  /** Short summary for search engines and link previews. */
  description?: string;
}

const settings = await getSettings();
const { title, description = settings.description } = Astro.props;
const pageTitle = title ? `${title} | ${settings.name}` : `${settings.name} | ${settings.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#ffffff" />

    <script is:inline>
      // Light mode is the default. Apply a saved dark-mode choice before the page draws.
      // Turn on the gentle scroll fade-in unless the visitor prefers reduced motion.
      (function () {
        const root = document.documentElement;
        try {
          if (localStorage.getItem('theme') === 'dark') root.dataset.theme = 'dark';
        } catch {}
        if (
          'IntersectionObserver' in window &&
          window.matchMedia('(prefers-reduced-motion: no-preference)').matches
        ) {
          root.classList.add('motion');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header name={settings.name} />
    <main id="main">
      <slot />
    </main>
    <Footer settings={settings} />

    <script is:inline>
      (function () {
        if (!document.documentElement.classList.contains('motion')) return;
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
      })();
    </script>
  </body>
</html>
